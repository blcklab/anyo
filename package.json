{
  "name": "@blcklab/anyo",
  "version": "0.10.0-rc.3",
  "description": "A secure, renderer-independent spatial web engine with replacement-safe plugin and system lifecycles, player-ready lifecycle, WebXR, renderer-neutral web-surface targets, and runtime systems.",
  "keywords": [
    "3d",
    "architecture",
    "building",
    "json",
    "virtual-store",
    "portfolio",
    "threejs",
    "webgl",
    "sekai64",
    "webgpu",
    "spatial-web",
    "json-world",
    "vrm",
    "headless",
    "editor",
    "authoring",
    "undo-redo",
    "web-surface",
    "spatial-ui",
    "html-in-3d",
    "animation",
    "physics",
    "runtime-systems",
    "transient-transforms",
    "vfx",
    "geospatial",
    "openstreetmap",
    "map-world",
    "procedural-geometry",
    "geometry",
    "world-authoring"
  ],
  "license": "MIT",
  "author": "blcklab",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./geometry": {
      "types": "./dist/types/geometry/index.d.ts",
      "import": "./dist/esm/geometry/index.js",
      "require": "./dist/cjs/geometry/index.js"
    },
    "./validation": {
      "types": "./dist/types/schema/index.d.ts",
      "import": "./dist/esm/schema/index.js",
      "require": "./dist/cjs/schema/index.js"
    },
    "./systems": {
      "types": "./dist/types/systems/index.d.ts",
      "import": "./dist/esm/systems/index.js",
      "require": "./dist/cjs/systems/index.js"
    },
    "./document": {
      "types": "./dist/types/document/index.d.ts",
      "import": "./dist/esm/document/index.js",
      "require": "./dist/cjs/document/index.js"
    },
    "./history": {
      "types": "./dist/types/history/index.d.ts",
      "import": "./dist/esm/history/index.js",
      "require": "./dist/cjs/history/index.js"
    },
    "./editor": {
      "types": "./dist/types/editor/index.d.ts",
      "import": "./dist/esm/editor/index.js",
      "require": "./dist/cjs/editor/index.js"
    },
    "./migrations": {
      "types": "./dist/types/migrations/index.d.ts",
      "import": "./dist/esm/migrations/index.js",
      "require": "./dist/cjs/migrations/index.js"
    },
    "./renderer": {
      "types": "./dist/types/renderer/index.d.ts",
      "import": "./dist/esm/renderer/index.js",
      "require": "./dist/cjs/renderer/index.js"
    },
    "./building": {
      "types": "./dist/types/building/index.d.ts",
      "import": "./dist/esm/building/index.js",
      "require": "./dist/cjs/building/index.js"
    },
    "./entities": {
      "types": "./dist/types/entities/index.d.ts",
      "import": "./dist/esm/entities/index.js",
      "require": "./dist/cjs/entities/index.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
